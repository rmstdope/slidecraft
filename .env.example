# Copy to .env; Bun loads it automatically. Every value is optional.

# Folder holding presentations (<name>/index.mdx), or a source id from ~/.config/slidecraft/config.json.
# SLIDECRAFT_CONTENT_DIR=~/my-presentations

# Alternative config file location (default ~/.config/slidecraft/config.json).
# SLIDECRAFT_CONFIG=

# Chat assistant, HTTP provider (any OpenAI-compatible chat-completions endpoint).
# Not needed for the Claude Code or Copilot CLI providers.
# AI_API_KEY=
# SLIDECRAFT_AI_URL=https://api.openai.com/v1/chat/completions
# SLIDECRAFT_AI_MODEL=

# Listen port; honoured only by the standalone release binary (dev ports are fixed at 6100/6110).
# PORT=6110

# Chrome or Chromium executable for PDF export.
# CHROME_PATH=

# Poll for file changes instead of relying on file-system events. Set this when edits do not
# reach the dev server (stale modules until a restart), as happens on some macOS setups.
# SLIDECRAFT_WATCH_POLLING=1
