{
  "name": "slidecraft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "MDX presentation framework: decks as MDX, rendered with React and motion, edited in the browser.",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:status": "bun scripts/dev.ts status",
    "dev:all": "concurrently \"bun run dev:server\" \"bun run dev:client\"",
    "dev:client": "vite",
    "dev:server": "bun --watch server/index.ts",
    "typecheck": "tsc",
    "build": "tsc && vite build && vite build --config vite.viewer.config.ts",
    "preview": "vite preview",
    "start": "bun server/index.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@fontsource/source-sans-3": "5.3.0",
    "@fontsource/zilla-slab": "5.3.0",
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "motion": "14.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.14.5",
    "@mdx-js/rollup": "3.1.1",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.2",
    "@types/estree": "1.0.9",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.5",
    "happy-dom": "20.14.5",
    "mdast-util-mdxjs-esm": "2.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
